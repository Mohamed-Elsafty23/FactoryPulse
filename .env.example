# ============================================================================
# FactoryPulse environment configuration
# Copy to .env and fill in real values.  .env is git-ignored.
# ============================================================================

# Which environment: local | azure_dev | azure_prod
ENV=local

STORAGE_BUCKET=factorypulse
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=factorypulse
POSTGRES_USER=factorypulse
POSTGRES_PASSWORD=factorypulse

SIM_MACHINES=20
SIM_MONTHS=12
SIM_ROWS=10000000
SIM_DEFECT_RATE=0.01
SIM_SEED=42

DOWNTIME_COST_EUR_PER_HOUR=2400

ADLS_ACCOUNT=
ADLS_CONTAINER=lake
